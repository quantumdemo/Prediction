# Server Environment Variables (Node.js / Next.js)
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://user:password@localhost:5432/football_ai_db
FASTAPI_SERVICE_URL=http://localhost:8000
API_FOOTBALL_KEY=your_api_football_key_here
MODAL_TOKEN=your_modal_token_here
SENTRY_DSN=your_sentry_dsn_here

# Client Environment Variables (Exposed to Browser in Next.js)
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_ENVIRONMENT=development

# Python / FastAPI ML Service Environment Variables
ENVIRONMENT=development
LOG_LEVEL=INFO
ML_SERVICE_PORT=8000
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=football_ai_db
